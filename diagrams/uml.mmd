classDiagram
    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    class Recurrence {
        <<enumeration>>
        NONE
        DAILY
        WEEKLY
        +interval() timedelta
    }

    class Owner {
        +str id
        +str name
        +str contact
        +int available_start
        +int available_end
        +List~Pet~ pets
        +add_pet(pet) void
        +remove_pet(pet) void
        +list_pets() List~Pet~
        +is_available(task) bool
    }

    class Pet {
        +str id
        +str name
        +int age
        +str breed
        +Owner owner
        +List~Task~ tasks
        +add_task(task) void
        +remove_task(task) void
        +list_tasks() List~Task~
    }

    class Task {
        +str id
        +str description
        +datetime start_time
        +int duration
        +Priority priority
        +Recurrence recurrence
        +bool completed
        +Pet pet
        +end_time() datetime
        +overlaps(other) bool
        +mark_complete() Task
    }

    class Scheduler {
        +Owner owner
        +get_all_tasks() List~Task~
        +filter_tasks(tasks, pet, completed, min_priority, start, end) List~Task~
        +sort_tasks(tasks) List~Task~
        +find_conflicts(tasks) List~Tuple~
        +build_schedule() List~Task~
    }

    Owner "1" o-- "*" Pet : has
    Pet "1" o-- "*" Task : has
    Task "*" --> "1" Pet : belongs to
    Pet "*" --> "0..1" Owner : owned by
    Task --> Priority
    Task --> Recurrence
    Scheduler --> Owner : schedules for
    Scheduler ..> Task : sorts, filters, checks conflicts
