classDiagram
    class Owner {
        +str name
        +List~Pet~ pets
        +add_pet(pet) void
        +remove_pet(pet) void
        +list_pets() List~Pet~
    }

    class Pet {
        +str name
        +int age
        +str breed
        +Owner owner
        +List~Task~ tasks
        +add_task(task) void
        +remove_task(task) void
        +list_tasks() List~Task~
    }

    class Task {
        +str description
        +str time_stamp
        +int duration
        +bool completed
        +str priority
        +mark_complete() void
    }

    class Scheduler {
        +List~Task~ tasks
        +get_all_tasks(pets) List~Task~
        +filter_tasks(tasks) List~Task~
    }

    Owner "1" o-- "*" Pet : has
    Pet "1" o-- "*" Task : has
    Scheduler ..> Owner : reads pets from
    Scheduler ..> Task : organizes
